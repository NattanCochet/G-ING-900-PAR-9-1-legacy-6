<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Profile</title>
    <link rel="stylesheet" href="/css/theme.css" />
    <link rel="stylesheet" href="/css/home.css" />
    <link rel="stylesheet" href="/css/profile.css" />
</head>

<body>
    <header class="topbar">
        <div class="topbar-inner">
            <div class="brand">
                <span class="brand-mark">&#9670;</span>
                <span class="brand-name">Legacy</span>
            </div>
            <div class="topbar-right">
                <span class="greeting" id="greeting"></span>
                <a href="/profile" class="icon-btn" title="Profile" aria-label="Profile"
                    style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">&#128100;</a>
                <button class="icon-btn theme-btn" id="themeBtn" title="Toggle Theme"
                    aria-label="Toggle Theme">&#9728;</button>
                <button class="icon-btn" id="logoutBtn" title="Sign out" aria-label="Sign out">&#9099;</button>
            </div>
        </div>
    </header>

    <main class="page profile-page">
        <div class="profile-container">
            <div class="view-header" style="margin-bottom: 32px;">
                <div class="board-heading">
                    <a href="/home" class="back-btn" style="text-decoration: none;">&larr; Home</a>
                    <div>
                        <h1 class="page-title">My Profile</h1>
                        <p class="page-subtitle">Manage your personal information and security settings.</p>
                    </div>
                </div>
            </div>

            <div class="profile-content">
                <form id="profileForm" class="profile-form card" novalidate>
                    <div class="form-section">
                        <h2 style="margin-top: 0; margin-bottom: 24px; font-size: 20px;">Personal Information</h2>
                        <div class="field">
                            <input type="text" id="profileName" placeholder=" " required autocomplete="off" />
                            <label for="profileName">Name</label>
                        </div>
                        <div class="field">
                            <input type="email" id="profileEmail" placeholder=" " required autocomplete="off" />
                            <label for="profileEmail">Email Address</label>
                        </div>
                    </div>

                    <div class="form-section" style="margin-top: 40px;">
                        <h2 style="margin-top: 0; margin-bottom: 8px; font-size: 20px;">Security</h2>
                        <p style="color: var(--text-secondary); margin-bottom: 24px; font-size: 14px;"></p>
                        <div class="field">
                            <input type="password" id="profileOldPassword" placeholder=" " autocomplete="off" />
                            <label for="profileOldPassword">Current Password</label>
                        </div>
                        <div class="field" style="margin-top: 16px;">
                            <input type="password" id="profileNewPassword" placeholder=" " autocomplete="off" />
                            <label for="profileNewPassword">New Password</label>
                        </div>
                        <div class="field" style="margin-top: 16px;">
                            <input type="password" id="profileConfirmPassword" placeholder=" " autocomplete="off" />
                            <label for="profileConfirmPassword">Confirm New Password</label>
                        </div>
                        <p id="passwordErrorMsg" style="color: var(--red); font-size: 13px; margin-top: 8px;" hidden>
                            Passwords do not match.</p>
                    </div>

                    <div class="form-actions"
                        style="margin-top: 40px; display: flex; justify-content: flex-end; gap: 12px;">
                        <button type="button" class="secondary-btn" id="cancelProfileBtn">Cancel</button>
                        <button type="submit" class="primary-btn" id="saveProfileBtn">Save Changes</button>
                    </div>
                </form>

                <div class="danger-zone card" style="border-color: rgba(255, 59, 48, 0.3);">
                    <h2 style="margin-top: 0; margin-bottom: 12px; font-size: 20px; color: var(--red);">Delete my
                        account</h2>
                    <p style="color: var(--text-secondary); margin-bottom: 24px; font-size: 14px;">Once you delete your
                        account, there is no going back. Please be certain.</p>
                    <button class="danger-btn" id="deleteAccountBtn">Delete Account</button>
                </div>
            </div>
        </div>
    </main>

    <div class="modal-overlay" id="deleteModalOverlay" hidden>
        <div class="modal">
            <h2 class="modal-title">Delete Account</h2>
            <p style="color: var(--text-secondary); margin-bottom: 24px; line-height: 1.5;">Are you sure ? This action
                cannot be undone and all your data will be permanently lost.
            </p>
            <div class="modal-actions">
                <button type="button" class="secondary-btn" id="cancelDeleteBtn">Cancel</button>
                <button type="button" class="danger-btn" id="confirmDeleteBtn">Yes, Delete My Account</button>
            </div>
        </div>
    </div>

    <div id="toasterContainer" class="toaster-container"></div>

    <script src="/js/profile.js"></script>
</body>

</html>
