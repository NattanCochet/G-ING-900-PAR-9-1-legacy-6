<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Home</title>
    <link rel="stylesheet" href="/css/theme.css" />
    <link rel="stylesheet" href="/css/home.css" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <div class="brand">
                <span class="brand-mark">&#9670;</span>
                <span class="brand-name">Legacy</span>
            </div>
            <div class="topbar-right">
                <span class="greeting" id="greeting"></span>
                <button class="icon-btn theme-btn" id="themeBtn" title="Toggle Theme" aria-label="Toggle Theme">&#9728;</button>
                <button class="icon-btn" id="logoutBtn" title="Sign out" aria-label="Sign out">&#9099;</button>
            </div>
        </div>
    </header>

    <main class="page">
        <section id="projectsView" class="view">
            <div class="view-header">
                <div>
                    <h1 class="page-title">My Projects</h1>
                    <p class="page-subtitle">Everything you're working on, in one place.</p>
                </div>
                <button class="primary-btn" id="newProjectBtn">
                    <span class="plus">+</span> New Project
                </button>
            </div>

            <div id="projectsGrid" class="projects-grid"></div>

            <div id="projectsEmpty" class="empty-state" hidden>
                <p class="empty-title">No projects yet</p>
                <p class="empty-subtitle">Create your first project to get started.</p>
            </div>
        </section>

        <section id="boardView" class="view" hidden>
            <div class="view-header">
                <div class="board-heading">
                    <button class="back-btn" id="backBtn">&larr; Projects</button>
                    <div>
                        <h1 class="page-title" id="boardTitle"></h1>
                        <p class="page-subtitle" id="boardSubtitle"></p>
                    </div>
                </div>
                <div class="board-actions">
                    <button class="secondary-btn" id="editProjectBtn">Edit Project</button>
                    <button class="danger-btn" id="deleteProjectBtn">Delete Project</button>
                </div>
            </div>

            <div id="board" class="board"></div>
        </section>
    </main>

    <div class="modal-overlay" id="projectModalOverlay" hidden>
        <div class="modal">
            <h2 class="modal-title" id="projectModalTitle">New Project</h2>
            <form id="projectForm" class="modal-form" novalidate>
                <div class="field">
                    <input type="text" id="projectName" placeholder=" " required autocomplete="off" />
                    <label for="projectName">Name</label>
                </div>
                <div class="field">
                    <input type="text" id="projectDescription" placeholder=" " autocomplete="off" />
                    <label for="projectDescription">Description (optional)</label>
                </div>
                <div class="modal-actions">
                    <button type="button" class="secondary-btn" id="cancelProjectBtn">Cancel</button>
                    <button type="submit" class="primary-btn" id="projectSubmitBtn">Create</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal-overlay" id="taskModalOverlay" hidden>
        <div class="modal">
            <h2 class="modal-title" id="taskModalTitle">Edit Task</h2>
            <form id="taskForm" class="modal-form" novalidate>
                <div class="field">
                    <input type="text" id="taskModalName" placeholder=" " required autocomplete="off" />
                    <label for="taskModalName">Name</label>
                </div>
                <div class="field">
                    <textarea id="taskModalDescription" placeholder=" " rows="4"></textarea>
                    <label for="taskModalDescription">Description (optional)</label>
                </div>
                <div class="field">
                    <input type="date" id="taskModalDeadline" placeholder=" " autocomplete="off" />
                    <label for="taskModalDeadline">Deadline</label>
                </div>
                <div class="field" style="display: flex; flex-direction: column;">
                    <select id="taskModalPriority" style="width: 100%; height: 50px; padding: 18px 16px 6px; font-size: 16px; font-family: inherit; color: var(--text); background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; outline: none; appearance: none;">
                        <option value="none">None</option>
                        <option value="low">Low</option>
                        <option value="medium">Medium</option>
                        <option value="high">High</option>
                    </select>
                    <label for="taskModalPriority" style="top: 7px; font-size: 11px;">Priority</label>
                </div>
                <div class="modal-actions">
                    <button type="button" class="secondary-btn" id="cancelTaskBtn">Cancel</button>
                    <button type="submit" class="primary-btn" id="taskSubmitBtn">Save</button>
                </div>
            </form>
        </div>
    </div>

    <div id="toasterContainer" class="toaster-container"></div>

    <script src="/js/dashboard.js"></script>
</body>
</html>
