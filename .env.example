# Database driver: 'sqlite3' (default) or 'mysql'
DB_TYPE=sqlite3

# SQLite configuration
SQLITE_DB_LOCATION=./todo.db

# MySQL configuration (required when DB_TYPE=mysql)
# Example values for local Docker Compose:
# MYSQL_HOST=db
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DB=todo_db
# MYSQL_PORT=3306
#
# For Railway: copy the values generated in Railway MySQL service
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_PORT=3306

JWT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NODE_ENV=development
PORT=3000
